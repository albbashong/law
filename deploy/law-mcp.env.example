# law-mcp 실행 환경 — law-mcp.env 로 복사해 값을 채운다(커밋 금지).
# 브이월드 키: parcel_zoning(주소 → 용도지역)에 쓴다
VWORLD_API_KEY=
# 법제처 DRF 인증값: term_link(일상어·별칭 → 법령 용어·법령명, 법제처 연계 자료)에 쓴다
LAW_API_OC=
# 외부에서 /mcp 를 직접 부를 때 Host 검사를 켜려면(쉼표 없이 JSON 배열)
# MCP_ALLOWED_HOSTS=["law-mcp:7017","dev-server:7017"]
# law_search 방식: trigram(기본) · words(낱말 색인) · vector(뜻, 임베딩 색인)를 '+' 로 이어 순위 융합(hybrid = trigram+words)
# words 는 data/lawdb_words.sqlite(scripts/build_words.py), vector 는 data/lawdb_vec/(scripts/build_vectors.py)와
# 임베딩 서버(OpenAI 호환 /embeddings)가 있어야 한다 — 없으면 그 방식만 빠진다
# SEARCH_METHOD=trigram+vector
# EMBED_URL=http://<임베딩 서버>/v1
# EMBED_MODEL=qwen3-embedding:0.6b
