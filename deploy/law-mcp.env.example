# law-mcp 실행 환경 — law-mcp.env 로 복사해 값을 채운다(커밋 금지).
# 브이월드 키: parcel_zoning(주소 → 용도지역)에 쓴다
VWORLD_API_KEY=
# 법제처 DRF 인증값: term_link(일상어·별칭 → 법령 용어·법령명, 법제처 연계 자료)에 쓴다
LAW_API_OC=
# 외부에서 /mcp 를 직접 부를 때 Host 검사를 켜려면(쉼표 없이 JSON 배열)
# MCP_ALLOWED_HOSTS=["law-mcp:7017","dev-server:7017"]
# law_search 방식: trigram(기본) · words(낱말 색인) · hybrid(둘을 순위 융합)
# words·hybrid 는 data/lawdb_words.sqlite 가 있어야 한다(scripts/build_words.py) — 없으면 trigram 으로 찾는다
# SEARCH_METHOD=trigram
