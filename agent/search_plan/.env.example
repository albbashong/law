# 검색 계획 에이전트(search_plan) 설정 — 실제 값은 .env (커밋 안 함)
AGENT_NAME=search_plan
PORT=7018
PUBLIC_URL=

# 시작 조문 고르기에 쓰는 모델(OpenAI 호환). 주소·키는 .env 에만
VLLM_BASE=
VLLM_MODEL=
VLLM_API_KEY=
REASONING_EFFORT=low
VLLM_TEMPERATURE=0

# law-mcp — ?caller= 는 추적 행에 호출자를 남겨 평가가 이 에이전트의 조회를 가려 보게 한다
MCP_SERVERS={"law":"http://localhost:7017/mcp?caller=search_plan"}

# 계획을 실을 facts 키
PLAN_KEY=검색_계획
# 후보 뽑기 · 경로 계산 · 필지 지역 도구
PLAN_SEARCH_TOOL=law_search
PLAN_SEARCH_LIMIT=20
# 범위마다 따로 찾아 합친다(법령을 먼저) — 한 번에 찾으면 조례가 후보를 채운다
PLAN_SEARCH_SCOPES=law,all
PLAN_ROUTE_TOOL=law_route
PLAN_PARCEL_TOOL=parcel_zoning
# 필지 결과에서 지역(시도 시군구)으로 이을 키
PLAN_REGION_KEYS=시도,시군구
# 시작 조문 고르기 지시와 그 JSON 키
PLAN_SELECT_PROMPT=select_prompt.txt
PLAN_PICK_KEY=시작
PLAN_ADDRESS_KEY=주소
PLAN_CANDIDATE_LINE="{n}. {law} {article} — {title}"
PLAN_START_MAX=3
PLAN_STEPS_MAX=16
# 계획 전체의 꼭 열 조문 상한(시작에 가까운 것부터)
PLAN_MUST_MAX=5
