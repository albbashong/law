# 법령 근거 조회 에이전트. 이름은 agent/runtime/src/config.py 의 Settings 필드와 1:1 이다.
AGENT_NAME=law-review
PORT=7016
PUBLIC_URL=

# OpenAI 호환 모델 서버(vLLM 등) 주소 — 예: http://<모델서버>:8000/v1
VLLM_BASE=http://localhost:8000/v1
VLLM_MODEL=gpt-oss-120b
# vLLM 에 인증을 걸었으면 그 키, 아니면 비워 둬도 된다(런타임이 자리채움 값을 넣는다)
VLLM_API_KEY=
REASONING_EFFORT=low
VLLM_TEMPERATURE=0.0

MCP_SERVERS={"law": "http://localhost:7017/mcp"}
# 되묻기(후보 다건) 상태를 내는 도구
CLARIFY_TOOLS=building_basis,zone_ratios,split_area,law_article,law_search,parcel_zoning

# 따라가기(law_article 재호출)에 라운드가 필요하다
ROUNDS_MAX=10
TOOL_RESULT_MAX_CHARS=9000
TOOL_RETRY_MAX=2
TASK_TTL_SEC=600
# 답변 인용 검증: 조문·별표 번호가 이번 대화의 도구 결과에 없으면 모델에 한 번 되돌린다
ANSWER_CITE_PATTERN=제\s*\d+\s*조(?:\s*의\s*\d+)?|별표\s*\d+(?:\s*의\s*\d+)?
# (법령명, 조문) 짝 검증: 앞말이 도구 결과의 법령명으로 끝나는데 그 법령의 조문이 아니면 되돌린다
ANSWER_PAIR_PATTERN=(?P<scope>[^|\n]*?)\s*\|?\s*(?P<cite>제\s*\d+\s*조(?:\s*의\s*\d+)?|별표\s*\d+(?:\s*의\s*\d+)?)
ANSWER_PAIR_KEYS=law,article
ANSWER_UNVERIFIED_TEXT="\n\n※ 다음 인용은 조회 결과로 확인되지 않았습니다(원문 확인 필요): {cites}"
ANSWER_NO_LOOKUP_TEXT="아직 근거를 하나도 조회하지 않고 답했습니다. 도구로 근거 조문을 먼저 조회하고, 그 원문으로 다시 답하세요."
# 도구가 '열어 볼 조문 목록'으로 표시한 칸에만 있던 인용을 되돌리는 문장
ANSWER_POINTER_RETRY_TEXT="다음 조문은 열어 볼 조문 목록에만 있고 원문을 열지 않았습니다: {cites}. 목록을 준 도구를 다시 부르지 말고 law_article 로 그 조문 원문을 열어 확인하거나, 열지 않을 조문은 답에서 빼고 다시 답하세요."
# 되돌린 뒤에도 답에 빠진 꼭 다룰 이름(필지 규제)을 답 끝에 붙이는 문장 — 비우면 안 붙임
MENTION_APPEND_TEXT="\n\n※ 이 땅에는 다음 규제도 걸려 있습니다: {names}. 각 규제에 따른 허가·신고·협의가 필요한지 관련 법령과 관할 기관에서 따로 확인하세요."
MENTION_APPEND_TEXTS='{"추가검토": "\n\n※ 함께 확인할 것: {names}"}'
# 답의 맨 끝(※ 알림·이야기 뒤)에 붙이는 마무리 — 모델이 본문 끝에 쓴 비슷한 문단은 뺀다
ANSWER_CLOSING_TEXT="더 필요하신 정보가 있으시면 알려 주세요."

# 검색 계획 에이전트(A2A) — 정하면 새 질문마다 먼저 '열어 볼 조문 순서'를 받아 질문 뒤에 붙인다. 비우면 지금과 같다
# 계획 에이전트만 쓰는 도구 — 답하는 모델에게는 주지 않는다
HIDDEN_TOOLS=law_route
PLAN_AGENT_URL=
PLAN_TIMEOUT_SEC=60
PLAN_KEY=검색_계획
PLAN_INTRO_TEXT="검색 계획 — 법령 데이터의 위임·인용 연결로 계산한 열어 볼 순서입니다. '꼭 열기' 조문은 law_article 로 원문을 열어 확인한 뒤 답하세요(질문과 관계없으면 열지 않아도 됩니다):"
PLAN_STEP_FORMAT="{n}. {law} {article} ({relation}){must}"
PLAN_MUST_TEXT=" — 꼭 열기"
PLAN_STOP_TEXT="계획이 더 내려가지 못한 곳: {stops}"
PLAN_RETRY_TEXT="검색 계획의 꼭 열 조문을 아직 열지 않았습니다: {steps}. 질문에 필요한 조문이면 law_article 로 원문을 열어 확인하고 다시 답하세요. 질문과 관계없는 조문이면 열지 않고 그대로 답해도 됩니다."
PLAN_LIST_RETRY_TEXT="검색 계획의 꼭 열 조문을 열었는데 답의 근거 표에 없습니다: {steps}. 질문에 쓰인 위임 단계면 근거 표에 법률 → 시행령 → 조례 순으로 한 줄씩 적고 다시 답하세요. 질문과 관계없는 조문이면 그대로 답해도 됩니다."
REQUIRE_ARGS_TEXT="도구를 부르지 않고 답했습니다. 도구 {tool}을(를) 부를 인자만 JSON 으로 채우세요. 설명은 쓰지 마세요."
# 비율 수치 검증 — 답의 %·N분의 M·1/N 값이 조회 원문의 비율 값과 맞지 않으면 한 번 되돌린다
ANSWER_RATE_CHECK=true
# 답에 쓴 법령명(「」·‘’ 안, 근거 표 첫 칸)이 조회 결과에 없으면 되돌린다 — 지어낸 법령명 방지
ANSWER_LAW_PATTERN=(?m)「([^」\n]+)」|‘([^’\n]{2,}?(?:법|법률|령|규칙|조례|규정))’|^\|\s*\**([^|*\s][^|*\n]+?(?:법|법률|령|규칙|조례|규정))\**\s*\|
# 「」 없이 늘여 쓴 정식명(…에 관한 법률, …법 시행령 꼴 — 법령 이름 짓는 법의 용어)도 조회 결과의 법령명으로 끝나야 한다
ANSWER_LAW_LOOSE_PATTERN=([^\S\n]*[가-힣A-Za-z0-9·ㆍ][가-힣A-Za-z0-9·ㆍ \t]{1,60}?(?:에 관한 (?:특별)?법률|에 관한 특별조치법|에 관한 법|법률|법)[^\S\n]+시행(?:령|규칙)|[^\S\n]*[가-힣A-Za-z0-9·ㆍ][가-힣A-Za-z0-9·ㆍ \t]{1,60}?에 관한 (?:특별)?법률|[^\S\n]*[가-힣A-Za-z0-9·ㆍ][가-힣A-Za-z0-9·ㆍ \t]{1,60}?에 관한 특별조치법)
ANSWER_LAW_KEYS=법령,law,약칭
# 답의 따옴표 인용문이 조회 원문에 그대로 있는지(공백·문장부호 무시, … 로 줄인 곳은 조각마다) — 지어낸 원문 인용 방지
ANSWER_QUOTE_PATTERN=“([^”\n]+)”|"([^"\n]+)"
ANSWER_QUOTE_MIN_CHARS=6
ANSWER_QUOTE_MATCH_RATIO=0.9
# 모델이 본문에 흘린 도구 호출 표기(【도구이름 …】 — 영문 식별자로 시작)를 최종 답에서 지운다
ANSWER_STRIP_PATTERN=[^\S\n]*【[A-Za-z_][^】\n]*】

# 도구 인자 검증 — 주소·지역은 사용자 발화나 도구 결과에 나온 값만 넘긴다(지어낸 예시 주소 차단)
ARG_GROUNDED_KEYS=address,region
# 작업 기억 대비책 — 오케스트레이터가 memory 를 data 파트로 돌려주면 끈다
MEMORY_LOCAL=true

# 예시·쉬운 설명 요청은 검증된 답을 이 지시로 한 번 더 불러 이야기로 바꾼다(비우면 끔)
STORY_PROMPT=story_prompt.txt
STORY_APPEND_FORMAT="{answer}\n\n---\n\n{story}"
STORY_UNVERIFIED_TEXT="\n\n[확인 안 된 인용] 검증된 답의 다음 인용은 조회 원문에서 확인되지 않았습니다. 이야기에는 쓰지 말고, 원문에서 확인된 조문만으로 쓰세요: {cites}"
# 답에 나온 법령상의 값(건폐율·면적·금액·기간 등)을 뽑아 parameters 아티팩트로 — 원문에 없는 값은 버린다
PARAM_PROMPT=param_prompt.txt
# 이야기 형식 검사(처음부터) — 맞지 않으면 다시 쓰게 하고, 그래도 아니면 사실 답
STORY_FORMAT_PATTERN=^예를 들어
# 이야기 전에 쓸 사유·관계를 JSON 으로 고르게 하고, 관계가 조회 원문에 그대로 있는지 대조(비우면 끔)
STORY_PLAN_PROMPT=story_plan_prompt.txt
STORY_PLAN_GROUNDED_KEYS=관계
# 설명틀(조문 생김새별 쓰는 법) — 모델이 retell_as_story 의 form 으로 고르고, 조회한 법령명을 {법령}에 채운다
STORY_FORMS_DIR=story_forms
STORY_LAW_KEYS=법령,law
# 검증된 답을 본 뒤 설명틀을 다시 고르고, 쓴 이야기를 답과 대조해 고칠 점이 있으면 다시 쓰게 한다(비우면 끔)
STORY_FORM_SELECT_PROMPT=story_form_select_prompt.txt
STORY_REVIEW_PROMPT=story_review_prompt.txt
STORY_REVIEW_HINT_TEXT="\n\n[기계 대조가 의심한 문장] 아래 문장은 붙인 조문이 답의 근거표에서 다른 내용의 행으로 읽혔습니다. 기계 대조는 한 문장에 조문이 둘이거나 말을 바꿔 쓰면 틀릴 수 있으니, 답의 근거표와 대조해 실제로 조문과 내용이 어긋난 것만 문제로 적으세요.\n{hints}"

# 분야 지침 — 모델이 연 법령·부른 도구에 맞는 domains/*.txt 를 공통 프롬프트 뒤에 붙인다
DOMAINS_DIR=domains
# 답 점검 — 인용·수치 검증을 통과한 답을 조회 원문과 대조해 고칠 점이 나오면 한 번 되돌린다.
# 켜려면 answer_review_prompt.txt. golden 에서 recall 이 떨어지고(0.88→0.82) 응답이 느려져 기본은 끈다.
# 질문 정리 — 도구 루프 전에 발화를 법률 용어의 중립 질문과 사용자의 짐작으로 나눈다(비우면 끔)
RESTATE_PROMPT=restate_prompt.txt
# 정리 단계가 고른 일상어·별칭(그린벨트·김영란법)을 법제처 연계 자료로 확인하는 MCP 도구
RESTATE_TERM_TOOL=term_link
# 질문 정리 단계가 '예시가 필요한 질문'이라고 보면(이 키가 true) 요청이 없어도 검증된 답을 이야기로 다시 쓴다
RESTATE_STORY_KEY=예시
# 앞 질문의 대상을 생략한 이어지는 질문이면 앞 턴의 조회를 먼저 다시 실행한다
RESTATE_FOLLOW_KEY=이어짐
RESTATE_TOOL_KEY=도구
RESTATE_LEAD_TOOLS=building_basis,zone_ratios,split_area,parcel_zoning,law_definition
# 연계를 못 찾은 말은 법령 이름 꼴일 때만 "확인되지 않음"을 붙인다 — 다른 말은 정리한 질문으로 평소대로 찾는다
RESTATE_TERM_FAILED_PATTERN=(?:법|법률|령|규칙|조례)$
ANSWER_REVIEW_PROMPT=answer_review_prompt.txt
# 켤 때 점검 범위 — follow_up_or_general: 이어지는 질문과 분야 도구 없이 법령을 연 답만, all: 모든 답
ANSWER_REVIEW_SCOPE=all
ANSWER_REVIEW_MAX=2
ANSWER_REVIEW_OPEN_KEY=열기
ANSWER_CONDITION_CHECK=true

# 진행 알림 — 도구 이름 대신 보일 문구
PROGRESS_TOOL_LABELS='{"building_basis": "지으려는 것의 건축 근거를 찾는 중", "zone_ratios": "건폐율·용적률 기준을 찾는 중", "split_area": "분할 제한면적을 찾는 중", "parcel_zoning": "필지의 용도지역·규제를 확인하는 중", "law_article": "조문 원문을 여는 중", "law_search": "법령·조례를 검색하는 중", "law_definition": "용어의 법령 정의를 찾는 중", "term_link": "법령 용어로 바꿔 확인하는 중"}'
PROGRESS_ARG_KEYS=address,region,zone,use,land_category,law,article,query,term,word
