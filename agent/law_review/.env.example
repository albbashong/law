# 법령 근거 조회 에이전트. 이름은 agent/runtime/src/config.py 의 Settings 필드와 1:1 이다.
AGENT_NAME=law-review
PORT=7016
PUBLIC_URL=

# OpenAI 호환 모델 서버(vLLM 등) 주소 — 예: http://<모델서버>:8000/v1
VLLM_BASE=http://localhost:8000/v1
VLLM_MODEL=gpt-oss-120b
# vLLM 에 인증을 걸었으면 그 키, 아니면 비워 둬도 된다(런타임이 자리채움 값을 넣는다)
VLLM_API_KEY=
REASONING_EFFORT=low
VLLM_TEMPERATURE=0.0

MCP_SERVERS={"law": "http://localhost:7017/mcp"}
# 되묻기(후보 다건) 상태를 내는 도구
CLARIFY_TOOLS=building_basis,law_article,law_search,parcel_zoning

# 따라가기(law_article 재호출)에 라운드가 필요하다
ROUNDS_MAX=10
TOOL_RESULT_MAX_CHARS=9000
TOOL_RETRY_MAX=2
TASK_TTL_SEC=600
# 답변 인용 검증: 조문·별표 번호가 이번 대화의 도구 결과에 없으면 모델에 한 번 되돌린다
ANSWER_CITE_PATTERN=제\s*\d+\s*조(?:\s*의\s*\d+)?|별표\s*\d+(?:\s*의\s*\d+)?
# (법령명, 조문) 짝 검증: 앞말이 도구 결과의 법령명으로 끝나는데 그 법령의 조문이 아니면 되돌린다
ANSWER_PAIR_PATTERN=(?P<scope>[^|\n]*?)\s*\|?\s*(?P<cite>제\s*\d+\s*조(?:\s*의\s*\d+)?|별표\s*\d+(?:\s*의\s*\d+)?)
ANSWER_PAIR_KEYS=law,article
ANSWER_UNVERIFIED_TEXT="\n\n※ 다음 인용은 조회 결과로 확인되지 않았습니다(원문 확인 필요): {cites}"
# 비율 수치 검증 — 답의 %·N분의 M·1/N 값이 조회 원문의 비율 값과 맞지 않으면 한 번 되돌린다
ANSWER_RATE_CHECK=true
# 답에 쓴 법령명(「」·‘’ 안, 근거 표 첫 칸)이 조회 결과에 없으면 되돌린다 — 지어낸 법령명 방지
ANSWER_LAW_PATTERN=(?m)「([^」\n]+)」|‘([^’\n]{2,}?(?:법|법률|령|규칙|조례|규정))’|^\|\s*\**([^|*\s][^|*\n]+?(?:법|법률|령|규칙|조례|규정))\**\s*\|
# 모델이 본문에 흘린 도구 호출 표기(【도구이름 …】 — 영문 식별자로 시작)를 최종 답에서 지운다
ANSWER_STRIP_PATTERN=[^\S\n]*【[A-Za-z_][^】\n]*】

# 도구 인자 검증 — 주소·지역은 사용자 발화나 도구 결과에 나온 값만 넘긴다(지어낸 예시 주소 차단)
ARG_GROUNDED_KEYS=address,region
# 작업 기억 대비책 — 오케스트레이터가 memory 를 data 파트로 돌려주면 끈다
MEMORY_LOCAL=true

# 예시·쉬운 설명 요청은 검증된 답을 이 지시로 한 번 더 불러 이야기로 바꾼다(비우면 끔)
STORY_PROMPT=story_prompt.txt
# 이야기 형식 검사(처음부터) — 맞지 않으면 다시 쓰게 하고, 그래도 아니면 사실 답
STORY_FORMAT_PATTERN=^예를 들어
# 이야기 전에 쓸 사유·관계를 JSON 으로 고르게 하고, 관계가 조회 원문에 그대로 있는지 대조(비우면 끔)
STORY_PLAN_PROMPT=story_plan_prompt.txt
STORY_PLAN_GROUNDED_KEYS=관계
# 설명틀(조문 생김새별 쓰는 법) — 모델이 retell_as_story 의 form 으로 고르고, 조회한 법령명을 {법령}에 채운다
STORY_FORMS_DIR=story_forms
STORY_LAW_KEYS=법령,law
# 검증된 답을 본 뒤 설명틀을 다시 고르고, 쓴 이야기를 답과 대조해 고칠 점이 있으면 다시 쓰게 한다(비우면 끔)
STORY_FORM_SELECT_PROMPT=story_form_select_prompt.txt
STORY_REVIEW_PROMPT=story_review_prompt.txt

# 분야 지침 — 모델이 연 법령·부른 도구에 맞는 domains/*.txt 를 공통 프롬프트 뒤에 붙인다
DOMAINS_DIR=domains
# 답 점검 — 인용·수치 검증을 통과한 답을 조회 원문과 대조해 고칠 점이 나오면 한 번 되돌린다.
# 켜려면 answer_review_prompt.txt. golden 에서 recall 이 떨어지고(0.88→0.82) 응답이 느려져 기본은 끈다.
ANSWER_REVIEW_PROMPT=
# 켤 때 점검 범위 — follow_up_or_general: 이어지는 질문과 분야 도구 없이 법령을 연 답만, all: 모든 답
ANSWER_REVIEW_SCOPE=follow_up_or_general
